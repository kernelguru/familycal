# Zeitzone der Familie (für Wiederholungen und Benachrichtigungstexte)
TZ=Europe/Berlin

# Superuser für das Admin-Panel (https://dein-server/_/). Nach dem ersten Start
# kannst du die Zeilen entfernen.
PB_ADMIN_EMAIL=admin@example.com
PB_ADMIN_PASSWORD=bitte-langes-passwort-setzen

# Optional: verschlüsselt Einstellungen wie SMTP-Passwörter. Genau 32 Zeichen.
# Erzeugen: openssl rand -hex 16
PB_ENCRYPTION_KEY=
